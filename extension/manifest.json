{
  "manifest_version": 3,
  "name": "Nox (spike)",
  "version": "0.0.1",
  "description": "Nox spike harness: Notion MCP OAuth, panel lifetime, native bridge.",
  "key": "",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "identity",
    "nativeMessaging",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.notion.so/*",
    "https://*.notion.com/*",
    "https://mcp.notion.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Nox"
  }
}